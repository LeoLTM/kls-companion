#!/usr/bin/env sh
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# ── Only run for Rust commits ───────────────────────────────────────────
STAGED_FILES=$(git diff --cached --name-only)
if ! echo "$STAGED_FILES" | grep -q '\.rs$'; then
  exit 0
fi

# ── Clippy (lint + auto-fix) ────────────────────────────────────────────
echo "${YELLOW}==> Running clippy --fix...${NC}"

CLIPPY_EXIT=0
CLIPPY_OUTPUT=$(cargo clippy --fix --allow-dirty --allow-staged \
  --bin "kls-companion" -p kls-companion -- -D warnings 2>&1) || CLIPPY_EXIT=$?

echo "$CLIPPY_OUTPUT"

# ── Format ──────────────────────────────────────────────────────────────
echo "${YELLOW}==> Running cargo fmt...${NC}"
cargo fmt

# ── Format gate ─────────────────────────────────────────────────────────
FMT_EXIT=0
FMT_OUTPUT=$(cargo fmt -- --check 2>&1) || FMT_EXIT=$?
echo "${GREEN}✓ Formatting complete.${NC}"

# ── Re-stage everything that was staged before ──────────────────────────
# (captures both clippy auto-fixes and cargo fmt changes in one commit)
if [ -n "$STAGED_FILES" ]; then
  echo "$STAGED_FILES" | xargs -r git add 2>/dev/null || true
fi

# ── Report ──────────────────────────────────────────────────────────────
if [ $CLIPPY_EXIT -ne 0 ]; then
  echo ""
  echo "${RED}✗ Clippy found errors that can't be auto-fixed (see above).${NC}"
  echo "  Auto-fixable issues have been applied and staged."
  echo "  Please fix the remaining issues manually, then commit again."
  exit $CLIPPY_EXIT
fi

if [ $FMT_EXIT -ne 0 ]; then
  echo ""
  echo "${RED}✗ cargo fmt --check failed.${NC}"
  echo "  This shouldn't normally happen — check the output above."
  exit $FMT_EXIT
fi

echo "${GREEN}✓ All good! Proceeding with commit.${NC}"